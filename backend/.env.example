# ─────────────────────────────────────────
# vlivechat Backend — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# For local dev:  use the DB_* individual vars (leave DATABASE_URL empty)
# For production: set DATABASE_URL (Neon.tech) and leave DB_* empty

# ── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Frontend / Widget CORS Origins ───────────────────────────────
# FRONTEND_URL      = your dashboard URL (Vercel)
# WIDGET_ORIGINS    = comma-separated list of domains that embed the widget
FRONTEND_URL=https://vlivechat.com
WIDGET_ORIGINS=https://vlivechat.com,https://www.vlivechat.com

# ── Database (Production — Neon.tech) ────────────────────────────
# Paste your full Neon connection string here (from neon.tech dashboard)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://vlcuser:password@ep-xxx.us-east-2.aws.neon.tech/vlivechat?sslmode=require

# ── Database (Local Dev only — leave blank if using DATABASE_URL) ─
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=vlivechat
# DB_USER=vlcuser
# DB_PASSWORD=vlcpassword123

# ── Redis (optional — app runs fine without it via in-memory fallback) ──
# On free tier: leave blank. App will auto-use in-memory cache.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random secret in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_MINIMUM_64_CHARS
JWT_EXPIRES_IN=7d

# ── File Uploads ──────────────────────────────────────────────────
# NOTE: On Render free tier, the filesystem is ephemeral (files reset on deploy).
# For production persistence, use Cloudinary (free tier: 25GB/month).
# For testing only, local disk is fine.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── SLA Defaults (minutes) ────────────────────────────────────────
SLA_FIRST_RESPONSE=5
SLA_RESOLUTION=60

# ── Superadmin (initial seed — only used on first migrate) ────────
SUPERADMIN_EMAIL=superadmin@vlivechat.com
SUPERADMIN_PASSWORD=SuperAdmin@2024!
